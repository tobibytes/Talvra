{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "e2e/**",
      "!e2e/test-results",
      "!e2e/playwright-report",
      "!**/dist",
      "!**/node_modules",
      "!**/routeTree.gen.ts",
      "!**/migrations/meta",
      "!**/.wrangler"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/src/components/ui/**",
        "apps/web/src/components/data-table/**",
        "apps/web/src/hooks/use-mobile.ts",
        "apps/web/src/hooks/use-data-table.ts",
        "apps/web/src/hooks/use-debounced-callback.ts",
        "apps/web/src/lib/data-table-*.ts",
        "apps/web/src/lib/format.ts"
      ],
      "linter": {
        "enabled": false
      }
    }
  ]
}
