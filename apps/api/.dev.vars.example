# Local secrets for `wrangler dev`. Copy to .dev.vars (gitignored) and fill in.
# Generate random values with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
CANVAS_TOKEN_KEY=
# Optional. Without these, the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional in development: without it, verification/reset emails print to the terminal.
RESEND_API_KEY=
# Claude (Talvra's own AI). Without it, AI features use Workers AI's basic model.
ANTHROPIC_API_KEY=
# Optional: Azure voices for videos (Workers AI narration otherwise).
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# Optional: try our own homework sandbox locally (docs/v2/SANDBOX.md). Start the image with
#   docker run --rm -p 8001:8000 -e ALLOW_NO_AUTH=1 talvra-sandbox:dev
# SANDBOX_URL=http://localhost:8001
# HOMEWORK_SANDBOX=self
