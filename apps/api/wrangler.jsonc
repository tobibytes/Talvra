{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talvra",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // One Worker serves the SPA and the API on the same origin. Requests to
  // /api/* run the Worker; everything else is a static asset, with unknown
  // paths falling back to index.html for client-side routing.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ENV": "development",
    "APP_VERSION": "2.0.0-alpha.0",
    "APP_URL": "http://localhost:5173",
    "ALLOWED_EMAIL_DOMAINS": "morgan.edu",
    "EMAIL_FROM": "Talvra <hello@talvra.app>"
  },
  // Neon through Hyperdrive. Create it with:
  //   wrangler hyperdrive create talvra-db --connection-string="$NEON_URL"
  // then paste the id here. Locally, wrangler dev uses localConnectionString.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
      "localConnectionString": "postgres://talvra:talvra@localhost:5432/talvra"
    }
  ],
  // Durable Canvas sync (src/sync/workflow.ts).
  "workflows": [
    { "name": "talvra-sync", "binding": "SYNC_WORKFLOW", "class_name": "SyncWorkflow" }
  ],
  // One Durable Object per user for live sync progress (src/realtime/user-hub.ts).
  "durable_objects": {
    "bindings": [
      { "name": "USER_HUB", "class_name": "UserHub" },
      { "name": "EXTRACT", "class_name": "ExtractContainer" },
      { "name": "MEDIA", "class_name": "MediaContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserHub"] },
    { "tag": "v2", "new_sqlite_classes": ["ExtractContainer"] },
    { "tag": "v3", "new_sqlite_classes": ["MediaContainer"] }
  ],
  // Workers AI: narration (text-to-speech). Runs remotely even in wrangler dev.
  "ai": { "binding": "AI" },
  // Originals, extracted Markdown and structure. Private; the API streams them.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "talvra-files-dev" }],
  // Ingest pipeline: sync and uploads produce, this Worker consumes.
  "queues": {
    "producers": [
      { "binding": "INGEST_QUEUE", "queue": "talvra-ingest-dev" },
      { "binding": "AI_QUEUE", "queue": "talvra-ai-dev" }
    ],
    "consumers": [
      // One generation at a time per batch: each is a long Claude stream.
      {
        "queue": "talvra-ai-dev",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "talvra-ai-dlq-dev"
      },
      {
        "queue": "talvra-ingest-dev",
        "max_batch_size": 4,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "talvra-ingest-dlq-dev"
      }
    ]
  },
  // Python extract service (apps/extract). No internet access (see ExtractContainer).
  "containers": [
    {
      "class_name": "ExtractContainer",
      "image": "../extract/Dockerfile",
      "max_instances": 3,
      "instance_type": "standard-1"
    },
    // Python media service (apps/media): narrated videos. No internet.
    {
      "class_name": "MediaContainer",
      "image": "../media/Dockerfile",
      "max_instances": 2,
      "instance_type": "standard-1"
    }
  ],
  // Every 15 minutes: reminders; every 30 (in code): incremental sync + stuck-document sweep.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Secrets (wrangler secret put NAME; locally in .dev.vars):
  //   BETTER_AUTH_SECRET, CANVAS_TOKEN_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, RESEND_API_KEY,
  //   ANTHROPIC_API_KEY
  "env": {
    "production": {
      "vars": {
        "APP_ENV": "production",
        "APP_VERSION": "2.0.0-alpha.0",
        "APP_URL": "https://talvra.app",
        "ALLOWED_EMAIL_DOMAINS": "morgan.edu",
        "EMAIL_FROM": "Talvra <hello@talvra.app>"
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "REPLACE_WITH_HYPERDRIVE_ID" }],
      // Bindings aren't inherited by environments; repeat them.
      "workflows": [
        {
          "name": "talvra-sync-production",
          "binding": "SYNC_WORKFLOW",
          "class_name": "SyncWorkflow"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "USER_HUB", "class_name": "UserHub" },
          { "name": "EXTRACT", "class_name": "ExtractContainer" },
          { "name": "MEDIA", "class_name": "MediaContainer" }
        ]
      },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "talvra-files" }],
      // Semantic search. Not in local dev (Vectorize has no local simulation), where
      // search falls back to Postgres full text. See ARCHITECTURE.md for setup.
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "VECTORS", "index_name": "talvra-chunks" }],
      "queues": {
        "producers": [
          { "binding": "INGEST_QUEUE", "queue": "talvra-ingest" },
          { "binding": "AI_QUEUE", "queue": "talvra-ai" }
        ],
        "consumers": [
          {
            "queue": "talvra-ai",
            "max_batch_size": 1,
            "max_retries": 3,
            "dead_letter_queue": "talvra-ai-dlq"
          },
          {
            "queue": "talvra-ingest",
            "max_batch_size": 4,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "talvra-ingest-dlq"
          }
        ]
      },
      "containers": [
        {
          "class_name": "ExtractContainer",
          "image": "../extract/Dockerfile",
          "max_instances": 5,
          "instance_type": "standard-1"
        },
        {
          "class_name": "MediaContainer",
          "image": "../media/Dockerfile",
          "max_instances": 3,
          "instance_type": "standard-1"
        }
      ],
      "triggers": { "crons": ["*/15 * * * *"] }
    }
  }
}
