{
  "name": "talvra",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Talvra: Canvas-connected study app for Morgan State students",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check . && turbo run typecheck test build",
    "db:generate": "pnpm --filter @talvra/db generate",
    "db:migrate": "pnpm --filter @talvra/db migrate",
    "e2e": "pnpm --filter @talvra/e2e e2e",
    "db:up": "docker compose -f infra/compose.dev.yml up -d",
    "db:down": "docker compose -f infra/compose.dev.yml down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
